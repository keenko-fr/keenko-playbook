{
  "name": "@<%= workspace %>/shared",
  "exports": {
    "./*": "./src/*.ts"
  },
  "nx": {
    "tags": ["type:package", "scope:shared"],
    "targets": {
      "typecheck": {
        "command": "node ../../node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "private": true,
  "type": "module"
}