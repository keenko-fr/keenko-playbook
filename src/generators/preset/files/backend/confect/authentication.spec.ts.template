import { FunctionSpec, GroupSpec } from "@confect/core";
import * as Schema from "effect/Schema";

import type { getCurrentAuthentication } from "./authentication";

// SCHEMAS ---------------------------------------------------------------------------------------------------------------------------------
export class AuthenticationRequired extends Schema.TaggedError<AuthenticationRequired>()("AuthenticationRequired", {}) {}

// SPEC ------------------------------------------------------------------------------------------------------------------------------------
export default GroupSpec.make()
  // QUERIES -------------------------------------------------------------------------------------------------------------------------------
  .addFunction(FunctionSpec.convexPublicQuery<typeof getCurrentAuthentication>()("getCurrentAuthentication"))
  .addFunction(
    FunctionSpec.publicQuery({
      error: () => AuthenticationRequired,
      name: "getProtectedAuthentication",
      returns: () =>
        Schema.Struct({
          subject: Schema.String,
          tokenIdentifier: Schema.String,
        }),
    })
  );
