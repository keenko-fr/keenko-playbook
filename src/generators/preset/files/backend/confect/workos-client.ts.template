import { AuthKit } from "@convex-dev/workos-authkit";
import { internalMutationGeneric } from "convex/server";
import type { GenericDataModel } from "convex/server";
import { v } from "convex/values";
import { Effect as E } from "effect";

import { components } from "./_generated/components";

declare const process: {
  readonly env: {
    readonly WORKOS_WEBHOOK_SECRET?: string;
  };
};

// AUTHKIT ---------------------------------------------------------------------------------------------------------------------------------
// The synchronized WorkOS user is authentication infrastructure identity. It is not the application's canonical domain user.
export const isWorkOSWebhookConfigured = () => {
  const webhookSecret = process.env.WORKOS_WEBHOOK_SECRET;
  return Boolean(webhookSecret);
};

export const makeAuthKit = () => new AuthKit<GenericDataModel>(components.workOSAuthKit);

// RECONCILIATION --------------------------------------------------------------------------------------------------------------------------
const unavailableBackfill = internalMutationGeneric({
  args: {},
  handler: () => E.runPromise(E.die("Configure WORKOS_WEBHOOK_SECRET before running the WorkOS user backfill.")),
  returns: v.null(),
});

export const backfillUsers = isWorkOSWebhookConfigured() ? makeAuthKit().utils().backfillUsers : unavailableBackfill;
