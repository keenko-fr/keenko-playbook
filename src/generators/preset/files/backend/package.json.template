{
  "name": "@<%= workspace %>/backend",
  "exports": {},
  "scripts": {
    "codegen": "confect codegen",
    "dev": "bun run --parallel \"dev:*\"",
    "dev:confect": "confect dev",
    "dev:convex": "convex dev"
  },
  "nx": {
    "tags": ["type:package", "scope:backend"],
