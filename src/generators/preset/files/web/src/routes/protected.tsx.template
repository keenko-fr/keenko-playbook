import { createFileRoute, redirect } from "@tanstack/react-router";
import { getAuth } from "@workos/authkit-tanstack-react-start";

import * as m from "#/paraglide/messages";

export const Route = createFileRoute("/protected")({
  loader: async ({ location }) => {
    const { user } = await getAuth();
    if (user === null)
      // oxlint-disable-next-line typescript/only-throw-error -- TanStack redirects are thrown control-flow responses.
      throw redirect({ href: `/api/auth/sign-in?returnPathname=${encodeURIComponent(location.pathname)}` });

    return { user };
  },
  component: ProtectedPage,
});

function ProtectedPage() {
  const { user } = Route.useLoaderData();

  return (
    <main>
      <h1>{m.quiet_silver_lynx()}</h1>
      <p>{user.email}</p>
    </main>
  );
}
