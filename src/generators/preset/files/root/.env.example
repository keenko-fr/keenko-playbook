# Reference only. `bun run dev` lets Convex provision AuthKit and writes real development values to untracked `.env.local`.
VITE_CONVEX_URL=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Non-secret domain controlled by the project and not routed to SSO. Used only by the provisioned auth smoke.
AUTH_E2E_EMAIL_DOMAIN=
