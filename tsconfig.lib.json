{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": false,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/generators/preset/files/root/oxlint.config.ts.template",
    "src/generators/preset/files/root/oxfmt.config.ts.template"
  ],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts", "src/infra/deps-update.ts"]
}
