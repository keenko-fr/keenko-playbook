{
  "name": "keenko",
  "version": "0.3.0",
  "private": false,
  "description": "An opinionated Nx-based TypeScript application distribution.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keenko-fr/keenko-playbook.git"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "generators.json",
    "migrations.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "build": "nx run-many -t build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run pack:check && bun run release:version:check",
    "deps:update": "bun run src/infra/deps-update.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "pack:check": "nx run keenko:pack:check",
    "release:wait-for-published": "bun run tests/wait-for-published.ts",
    "release:version:check": "bun run tests/release-version.ts",
    "test": "bun test",
    "test:product": "bun run tests/packed-product.ts && bun run tests/packed-migration.ts",
    "test:published": "bun run tests/packed-product.ts --published",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@nx/devkit": "23.2.0",
    "@tanstack/create": "0.70.0",
    "effect": "4.0.0-rc.112",
    "tslib": "2.8.1",
    "validate-npm-package-name": "8.0.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.43.0",
    "@nx/js": "23.2.0",
    "@nx/oxlint": "23.2.0",
    "@types/bun": "1.4.2",
    "@types/node": "24.13.3",
    "@types/validate-npm-package-name": "4.0.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "nx": "23.2.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-plugin-effect": "0.12.1",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "6.0.2",
    "ultracite": "7.11.0",
    "verdaccio": "6.10.3"
  },
  "engines": {
    "bun": ">=1.4.0 <2",
    "node": ">=24 <25"
  },
  "generators": "./generators.json",
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "dist",
          "main": "src/index.ts",
          "tsConfig": "tsconfig.lib.json",
          "rootDir": "src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      },
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "listenAddress": "127.0.0.1",
          "location": "none",
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage",
          "clear": false
        }
      },
      "pack:check": {
        "dependsOn": [
          "build"
        ],
        "command": "bun pm pack --dry-run --ignore-scripts",
        "options": {
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "nx-migrations": {
    "migrations": "./migrations.json"
  }
}
