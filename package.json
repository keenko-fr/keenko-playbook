{
  "name": "keenko-playbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keenko engineering conventions and portable agent workflows for Codex and Claude.",
  "license": "MIT",
  "bin": {
    "playbook": "cli/playbook.ts"
  },
  "scripts": {
    "playbook": "bun cli/playbook.ts",
    "check": "bun cli/playbook.ts check --source && bun test",
    "check:release": "bun cli/playbook.ts check --source --release && bun test",
    "vendor:sync": "bun cli/vendor-sync.ts",
    "vendor:update": "bun cli/vendor-sync.ts --update",
    "release:prepare": "bun cli/release.ts"
  }
}
