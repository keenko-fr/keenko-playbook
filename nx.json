{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "defaultBase": "main",
  "targetDefaults": {
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"]
    }
  },
  "release": {
    "projects": ["keenko"],
    "versionPlans": true,
    "version": {
      "adjustSemverBumpsForZeroMajorVersion": false,
      "preVersionCommand": "bunx nx run-many -t build"
    },
    "changelog": {
      "projectChangelogs": {
        "createRelease": "github"
      }
    }
  }
}
