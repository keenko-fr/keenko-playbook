{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "neverConnectToCloud": true,
  "release": {
    "projects": ["keenko"],
    "releaseTag": {
      "pattern": "v{version}"
    },
    "versionPlans": true,
    "version": {
      "adjustSemverBumpsForZeroMajorVersion": false
    },
    "changelog": {
      "automaticFromRef": true,
      "workspaceChangelog": {
        "file": "{workspaceRoot}/CHANGELOG.md",
        "createRelease": "github"
      }
    }
  },
  "targetDefaults": {
    "check": {
      "cache": true,
      "dependsOn": ["^check"]
    }
  }
}
