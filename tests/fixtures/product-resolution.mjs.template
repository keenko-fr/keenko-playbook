import assert from "node:assert/strict";
import { existsSync, readFileSync, readdirSync, realpathSync } from "node:fs";
import { createRequire } from "node:module";
import { join, resolve } from "node:path";

const workspace = resolve(process.argv[1]);
const root = createRequire(join(workspace, "package.json"));
const manifest = root("./package.json");
const plugin = root.resolve("nx/src/plugins/js/utils/typescript");
const nx = createRequire(plugin);
const rootTypescript = realpathSync(root.resolve("typescript"));
const nxTypescript = realpathSync(nx.resolve("typescript"));
assert.equal(process.versions.node.split(".")[0], "24", "Product tooling must use supported Node 24");
assert.equal(readFileSync(join(workspace, "bunfig.toml"), "utf8"), '[install]\nlinker = "isolated"\nhoist = false\n');
assert.equal(existsSync(join(workspace, "node_modules/.bun/node_modules")), false, "Phantom fallback must be disabled");
assert.equal(nxTypescript, rootTypescript, "Nx must resolve the root direct TypeScript JavaScript API");
assert.equal(root("typescript/package.json").version, manifest.devDependencies.typescript);
assert.equal(typeof nx("typescript").readConfigFile, "function", "Nx requires the TypeScript JavaScript API");
const native = realpathSync(root.resolve("@typescript/native"));
assert.equal(manifest.devDependencies["@typescript/native"], `npm:typescript@${root("@typescript/native/package.json").version}`);
assert.notEqual(native, rootTypescript, "The native compiler must remain independent of the JavaScript API");
const semver = createRequire(root.resolve("nx/package.json"))("semver");
const manifests = [
  "package.json",
  "packages/backend/package.json",
  "packages/ui/package.json",
  "packages/shared/package.json",
  ...readdirSync(join(workspace, "apps"))
    .map((app) => `apps/${app}/package.json`)
    .filter((file) => existsSync(join(workspace, file))),
];
for (const file of manifests) {
  const owner = createRequire(join(workspace, file));
  const owned = owner("./package.json");
  for (const name of Object.keys({ ...owned.dependencies, ...owned.devDependencies })) {
    if (name.startsWith("@keenko-product/") || name.startsWith("@" + manifest.name + "/") || name === "keenko") continue;
    let contract;
    try {
      contract = owner(name + "/package.json");
    } catch (error) {
      if (error.code === "ERR_PACKAGE_PATH_NOT_EXPORTED") continue;
      throw error;
    }
    const dependency = createRequire(owner.resolve(name + "/package.json"));
    for (const [peer, range] of Object.entries(contract.peerDependencies ?? {})) {
      if (contract.peerDependenciesMeta?.[peer]?.optional) continue;
      const peerVersion = dependency(peer + "/package.json").version;
      assert.ok(
        semver.satisfies(peerVersion, range, { includePrerelease: true }),
        `${file}: ${name} needs ${peer} ${range}, resolved ${peerVersion}`
      );
    }
  }
}
const nxPackages = {};
for (const [name, version] of Object.entries({ ...manifest.dependencies, ...manifest.devDependencies })) {
  if (name === "nx" || name.startsWith("@nx/")) {
    const installed = root(name + "/package.json").version;
    assert.ok(semver.satisfies(installed, version, { includePrerelease: true }), `${name} installed version must satisfy its manifest`);
    nxPackages[name] = { path: realpathSync(root.resolve(name + "/package.json")), version: installed };
  }
}
if (manifest.devDependencies["@effect/vitest"]) {
  assert.equal(root("vitest/package.json").version, "5.0.3");
  assert.equal(root("@effect/vitest/package.json").version, manifest.devDependencies["@effect/vitest"]);
  assert.equal(
    createRequire(root.resolve("vitest/package.json"))("vite/package.json").version.split(".")[0],
    "8",
    "Vitest must resolve compatible Vite 8"
  );
}
const backend = createRequire(join(workspace, "packages/backend/package.json"));
const authkitManifest = backend("@convex-dev/workos-authkit/package.json");
assert.equal(authkitManifest.version, "0.2.10");
assert.deepEqual(authkitManifest.exports["./test"], { types: "./dist/test.d.ts", default: "./src/test.ts" });
const authkitEntry = realpathSync(backend.resolve("@convex-dev/workos-authkit/test"));
const authkitRequire = createRequire(authkitEntry);
// The adapter must not acquire backend-owned helpers through a phantom fallback.
assert.throws(() => authkitRequire.resolve("convex-test"), { code: "MODULE_NOT_FOUND" });
// A consumer may declare Vite at the root. Require its exact ancestor identity
// when present; otherwise AuthKit must retain strict isolation.
if (manifest.dependencies?.vite || manifest.devDependencies?.vite)
  assert.equal(realpathSync(authkitRequire.resolve("vite/package.json")), realpathSync(root.resolve("vite/package.json")));
else assert.throws(() => authkitRequire.resolve("vite/package.json"), { code: "MODULE_NOT_FOUND" });
assert.equal(manifest.patchedDependencies["@convex-dev/workos-authkit@0.2.10"], "patches/keenko-workos-authkit-0.2.10.patch");
const authkitTypes = realpathSync(join(authkitEntry, "../../dist/test.d.ts"));
assert.doesNotMatch(readFileSync(authkitTypes, "utf8"), /(?:convex-test|vite\/client)/u);
const convexTest = realpathSync(backend.resolve("convex-test"));
const vite = realpathSync(createRequire(root.resolve("vitest/package.json")).resolve("vite/package.json"));
const effects = Object.fromEntries(
  ["packages/backend", "packages/shared"].map((directory) => {
    const req = createRequire(join(workspace, directory, "package.json"));
    const owned = req("./package.json").dependencies.effect;
    assert.equal(req("effect/package.json").version, owned, `${directory} Effect must agree with its manifest`);
    assert.equal(req("effect").Effect.runSync(req("effect").Effect.succeed("ok")), "ok");
    return [directory, realpathSync(req.resolve("effect"))];
  })
);
console.log(
  JSON.stringify({
    rootTypescript,
    nxTypescript,
    typescriptVersion: nx("typescript/package.json").version,
    readConfigFile: typeof nx("typescript").readConfigFile,
    native,
    nativeVersion: root("@typescript/native/package.json").version,
    nxPackages,
    effects,
    authkitEntry,
    authkitTypes,
    convexTest,
    vite,
  })
);
