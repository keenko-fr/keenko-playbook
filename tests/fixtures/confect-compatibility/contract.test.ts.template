import { QueryStream } from "@confect/server";
import { TestConfect } from "@confect/test";
import { it } from "@effect/vitest";
import { Cause, Effect as E, Option as O, Schema as S, Stream } from "effect";
import { expect } from "vitest";

import convexSchema from "../confect/_generated/convexSchema";
import refs from "../confect/_generated/refs";
import schema from "../confect/_generated/schema";
import { DatabaseReader, DatabaseWriter, MutationCtx } from "../confect/_generated/services";
import { sChecked } from "../confect/tables/compatibilityRows";
import * as compatibilityData from "../data/compatibility";
import { FooDefect, FooFailure, sFooSchemaIssue } from "../errors/foo";

const Test = TestConfect.TestConfect<typeof schema>();
const layer = TestConfect.layer(schema, convexSchema, {
  "../convex/_generated/api.js": () => import("../convex/_generated/api.js"),
  "../convex/compatibility.ts": () => import("../convex/compatibility"),
});

it.effect("reuses optional persistence from two features and rolls back business failure at the root", () =>
  E.gen(function* () {
    const t = yield* Test;
    const failure = yield* t.mutation(refs.public.compatibility.create, { key: "audit-rollback", score: 0, reject: false }).pipe(E.flip);
    expect(failure).toBeInstanceOf(FooFailure);
    expect(failure.issue).toBe("forbidden");
    expect(O.isNone(yield* t.query(refs.public.compatibility.find, { key: "audit-rollback" }))).toBe(true);
    yield* t.run(
      E.gen(function* () {
        expect(O.isNone(yield* compatibilityData.findByKey("missing"))).toBe(true);
        expect((yield* compatibilityData.getByKey("missing").pipe(E.flip))._tag).toBe("GetByIndexFailure");
      })
    );
  }).pipe(E.provide(layer))
);

it.effect("preserves typed failures and root rollback with direct feature writes", () =>
  E.gen(function* () {
    const t = yield* Test;
    const failure = yield* t.mutation(refs.public.compatibility.create, { key: "rollback", score: 1, reject: true }).pipe(E.flip);
    expect(failure).toBeInstanceOf(FooFailure);
    expect(failure.issue).toBe("forbidden");
    expect(O.isNone(yield* t.query(refs.public.compatibility.find, { key: "rollback" }))).toBe(true);
    yield* t.mutation(refs.public.compatibility.create, { key: "committed", score: 1, reject: false });
    expect(O.getOrThrow(yield* t.query(refs.public.compatibility.find, { key: "committed" })).score).toBe(1);
  }).pipe(E.provide(layer))
);

it.effect("keeps canonical SchemaError, Failure and Defect categories distinct", () =>
  E.gen(function* () {
    expect(yield* S.decodeUnknownEffect(sFooSchemaIssue)("invalid").pipe(E.flip)).toBeInstanceOf(S.SchemaError);
    expect(yield* E.fail(new FooFailure({ issue: "not_found" })).pipe(E.flip)).toBeInstanceOf(FooFailure);
    const defect = yield* E.die(new FooDefect({ issue: "inconsistent_state" })).pipe(E.exit);
    expect(defect._tag).toBe("Failure");
    if (defect._tag === "Failure") expect(Cause.hasDies(defect.cause)).toBe(true);
  })
);

it.effect("qualifies stable Confect codegen, named runners, codecs and cardinality", () =>
  E.gen(function* () {
    const t = yield* Test;
    expect(O.isNone(yield* t.query(refs.public.compatibility.find, { key: "missing" }))).toBe(true);
    yield* t.run(
      E.gen(function* () {
        const reader = yield* DatabaseReader;
        const writer = yield* DatabaseWriter;
        const rows = reader.table("compatibilityRows");
        const stream = () => rows.stream("by_key", (q) => q.eq("key", "one"));
        expect(O.isNone(yield* stream().pipe(QueryStream.unique))).toBe(true);
        expect((yield* rows.get("by_key", "one").pipe(E.flip))._tag).toBe("GetByIndexFailure");
        yield* writer.table("compatibilityRows").insert({ key: "one", score: 1 });
        expect(O.getOrThrow(yield* stream().pipe(QueryStream.unique)).score).toBe(1);
        expect((yield* rows.get("by_key", "one")).score).toBe(1);
        yield* writer.table("compatibilityRows").insert({ key: "one", score: 2 });
        expect((yield* stream().pipe(QueryStream.unique, E.flip))._tag).toBe("NotUniqueError");
        expect(
          O.getOrThrow(
            yield* stream().pipe(
              QueryStream.filter((row) => row.score === 1),
              QueryStream.unique
            )
          ).score
        ).toBe(1);
        const page = yield* QueryStream.paginate(stream(), { cursor: null, numItems: 1 });
        expect(page.page.length).toBe(1);
        const next = yield* QueryStream.paginate(stream(), { cursor: page.continueCursor, numItems: 1 });
        expect(next.page.length).toBe(1);
        expect(next.page[0]?._id).not.toBe(page.page[0]?._id);
        expect(O.isSome(yield* stream().pipe(Stream.runHead))).toBe(true);
        expect((yield* rows.index("by_key", (q) => q.eq("key", "one")).collect()).length).toBe(2);
        expect((yield* rows.get("by_key", "one").pipe(E.exit))._tag).toBe("Failure");
        yield* writer.table("compatibilityRows").insert({ key: "runner", score: 3 });
        const ctx = yield* MutationCtx;
        yield* E.promise(() => ctx.db.insert("compatibilityRows", { key: "invalid-field", score: -1 }));
        expect((yield* rows.get("by_key", "invalid-field").pipe(E.flip))._tag).toBe("DocumentDecodeError");
        // The qualified system-field derivation preserves outer checks in the registered reader.
        expect(S.is(sChecked)({ key: "outer-invalid", score: 1 })).toBe(false);
        yield* E.promise(() => ctx.db.insert("compatibilityRows", { key: "outer-invalid", score: 1 }));
        expect((yield* rows.get("by_key", "outer-invalid").pipe(E.flip))._tag).toBe("DocumentDecodeError");
      })
    );
    expect(O.getOrThrow(yield* t.query(refs.public.compatibility.forward, { key: "runner" })).score).toBe(3);
  }).pipe(E.provide(layer))
);

it.effect("creates a fresh database for each direct TestConfect layer provision", () =>
  E.gen(function* () {
    const t = yield* Test;
    expect(O.isNone(yield* t.query(refs.public.compatibility.find, { key: "runner" }))).toBe(true);
  }).pipe(E.provide(layer))
);
