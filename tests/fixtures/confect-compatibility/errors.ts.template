import { Schema as S } from "effect";

// FAILURES --------------------------------------------------------------------------------------------------------------------------------
export const sCompatibilityFailureIssue = S.Literals(["forbidden", "invalid_configuration", "missing_configuration", "not_found", "unusable"]);
export type CompatibilityFailureIssue = typeof sCompatibilityFailureIssue.Type;

export class CompatibilityFailure extends S.TaggedError<CompatibilityFailure>()("CompatibilityFailure", {
  issue: sCompatibilityFailureIssue,
}) {}
