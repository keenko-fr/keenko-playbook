{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023",
    "types": ["bun", "node"]
  },
  "include": [
    "tests/**/*.ts",
    "src/**/*.ts",
    "src/generators/preset/files/root/oxlint.config.ts.template",
    "src/generators/preset/files/root/oxfmt.config.ts.template"
  ]
}
